# Copy to .env and fill in. EXPO_PUBLIC_* values ship in the client bundle by
# design and are protected by Row Level Security — never put a service-role key
# or an OpenAI key here. Those belong in Supabase > Edge Functions > Secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
